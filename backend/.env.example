# Copy to .env for local development. Never commit real secrets to Git.
DATABASE_URL=postgresql+psycopg://factmap:local-dev-only@localhost:5433/factmap
STORAGE_DIR=./storage
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_TTL_SECONDS=86400
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
RATE_LIMIT_PER_MINUTE=60
ML_BACKEND=transformers
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
NLI_MODEL=cross-encoder/nli-deberta-v3-xsmall
NLI_CLASS_WEIGHTS=16.0,1.5,1.0
NLI_MAX_LENGTH=320
CLAIM_MODE=hybrid
CLAIM_THRESHOLD=0.55
MAX_CLAIMS_PER_DOC=40
PASSAGE_TARGET_CHARS=650
TOP_K=5
ML_BATCH_SIZE=16
ML_DEVICE=cpu
LOG_LEVEL=INFO
